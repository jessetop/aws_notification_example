{
  "name": "aws-notification-system-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Municipality-style multi-channel notification system on AWS with CloudWatch detection, Bedrock AI summarization, Step Functions orchestration, and togglable delivery channels.",
  "bin": {
    "app": "app/cdk-app.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "watch": "tsc -w",
    "synth": "cdk synth --profile roitraining --region us-east-1",
    "bootstrap": "cdk bootstrap --profile roitraining --region us-east-1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "destroy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/destroy.ps1",
    "diff": "cdk diff --profile roitraining --region us-east-1",
    "test": "node --test -r ts-node/register/transpile-only test/logic.test.ts test/logs.test.ts",
    "test:infra": "node --test -r ts-node/register/transpile-only test/template.test.ts",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/instances.ps1 -Action stop",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/instances.ps1 -Action start",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/instances.ps1 -Action status",
    "test-alarm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/send-test-alarm.ps1",
    "test:all": "npm test && npm run test:infra"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1171.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1171.0",
    "@aws-sdk/client-dynamodb": "^3.1171.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/client-secrets-manager": "^3.1171.0",
    "@aws-sdk/client-sfn": "^3.1171.0",
    "@aws-sdk/client-sns": "^3.1171.0",
    "@aws-sdk/lib-dynamodb": "^3.1171.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1148.1",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
