{
  "app": "npx ts-node --prefer-ts-exts app/cdk-app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "node_modules",
      "lambda/**",
      "ui/**",
      "ec2/**",
      "scripts/**"
    ]
  },
  "context": {
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/aws-rds:lowercaseDbIdentifier": true,
    "@aws-cdk/aws-s3:serverAccessLogs": false,
    "@aws-cdk/aws-s3:defaultBucketPolicy": false
  }
}
